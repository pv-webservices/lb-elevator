# Set the approved production origin before the production build.
PUBLIC_SITE_URL=
# Optional approved HTTPS form-provider endpoint. Never put private credentials here.
PUBLIC_FORM_ENDPOINT=
# Server-side only: used by `npm run images` (scripts/images/generate.mjs). Never expose to the browser.
OPENAI_API_KEY=
# Optional overrides (defaults live in scripts/images/config.mjs).
OPENAI_IMAGE_MODEL_FLARE=
OPENAI_IMAGE_MODEL_SUNBURST=
OPENAI_IMAGE_QUALITY_DEFAULT=
OPENAI_IMAGE_QUALITY_PREMIUM=
# Optional WhatsApp number in international format without + or spaces.
PUBLIC_WHATSAPP_NUMBER=
