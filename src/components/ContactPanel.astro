---
import OfficeMap from './OfficeMap.astro';
import { business, offices } from '../data/site';
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
interface Props {
  map?: boolean;
}
const { map = true } = Astro.props;
const tel = (p: string) => `tel:${p.replaceAll(' ', '')}`;
---

<div class="contact-panel reveal">
  <p class="eyebrow light">Let’s talk</p>
  <h2>
    A conversation is a <em class="serif">good place to start.</em>
  </h2>
  <p class="contact-company">{business.company}</p>
  <ul class="contact-list">
    {
      offices.map((o) => (
        <li class="contact-office">
          <span class="contact-icon">
            <Icon name="pin" size={20} />
          </span>
          <div>
            <small>{o.name}</small>
            <a
              class="contact-address"
              href={o.map}
              target="_blank"
              rel="noopener noreferrer"
            >
              {o.address}
            </a>
            <div class="contact-phones">
              {o.phones.map((p) => (
                <a href={tel(p)}>
                  <Icon name="phone" size={14} />
                  {p}
                </a>
              ))}
            </div>
          </div>
        </li>
      ))
    }
    <li>
      <span class="contact-icon wa">
        <WhatsAppIcon size={21} />
      </span>
      <div>
        <small>WhatsApp</small>
        <a
          href={`https://wa.me/${business.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat with our team
        </a>
      </div>
    </li>
    <li>
      <span class="contact-icon"><Icon name="mail" size={20} /></span>
      <div>
        <small>Email</small>
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </div>
    </li>
  </ul>
  {
    map && (
      <div class="map-pair">
        {offices.map((o) => (
          <div class="map-frame">
            <OfficeMap src={o.mapEmbed} title={`Map of the LB Elevators ${o.name}, ${o.city}`} href={o.map} />
            <a
              class="map-open"
              href={o.map}
              target="_blank"
              rel="noopener noreferrer"
            >
              {o.city} <Icon name="external" size={14} />
            </a>
          </div>
        ))}
      </div>
    )
  }
</div>
