---
import { business, products, services } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { SITE_URL } from '../data/config';
interface Props {
  quote?: boolean;
  id?: string;
}
const { quote = false, id = 'enquiry' } = Astro.props;
const endpoint = `https://formsubmit.co/ajax/${business.email}`;
---

<form
  class="enquiry-form"
  action={`https://formsubmit.co/${business.email}`}
  method="POST"
  data-enquiry
  data-endpoint={endpoint}
  data-whatsapp={business.whatsapp}
>
  <input type="hidden" name="_next" value={`${SITE_URL}/thank-you/`} />
  <input type="hidden" name="_subject" value={`New LB Elevators ${quote ? 'quotation request' : 'enquiry'}`} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="form-type" value={quote ? 'Quotation request' : 'Enquiry'} />
  <input type="hidden" name="source-page" value={new URL(Astro.url.pathname, SITE_URL).href} />
  <div class="form-grid">
    <label for={`${id}-name`}>
      Full name <span>*</span>
      <input
        id={`${id}-name`}
        name="name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
        placeholder="Your full name"
      />
    </label>
    <label for={`${id}-phone`}>
      Phone number <span>*</span>
      <input
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        pattern="\+?(?:[\s\(\)\-]*[0-9]){10,15}[\s\(\)\-]*"
        maxlength="20"
        title="Enter 10–15 digits, optionally separated by spaces, brackets or hyphens."
        placeholder="Your phone number"
      />
    </label>
    <label class:list={[!quote && 'full']} for={`${id}-email`}>
      Email address <span>*</span>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="150"
        placeholder="you@example.com"
      />
    </label>
    {quote && (
      <label for={`${id}-city`}>
        City / location <span>*</span>
        <input
          id={`${id}-city`}
          name="location"
          required
          autocomplete="address-level2"
          maxlength="150"
          placeholder="Project location"
        />
      </label>
    )}
    <label for={`${id}-building`}>
      Building type <span>*</span>
      <select id={`${id}-building`} name="building" required>
        <option value="">Select building type</option>
        {[
          'Residential',
          'Commercial',
          'Industrial',
          'Healthcare',
          'Hospitality',
          'Educational / Institutional',
          'Other',
        ].map((x) => (
          <option>{x}</option>
        ))}
      </select>
    </label>
    <label for={`${id}-interest`}>
      Interested in <span>*</span>
      <select id={`${id}-interest`} name="interest" required>
        <option value="">Select a solution</option>
        {products.map((p) => (
          <option>{p.name}</option>
        ))}
        {!quote && services.map((s) => <option>{s.name}</option>)}
        <option>Guidance on the right solution</option>
      </select>
    </label>
    {quote && (
      <>
        <label for={`${id}-service`}>
          Service required
          <select id={`${id}-service`} name="service">
            <option value="">Please advise me</option>
            {services.map((s) => (
              <option>{s.name}</option>
            ))}
          </select>
        </label>
        <label for={`${id}-method`}>
          Preferred contact method
          <select id={`${id}-method`} name="contact-method">
            <option>Phone call</option>
            <option>Email</option>
          </select>
        </label>
      </>
    )}
    <label class="full" for={`${id}-message`}>
      {quote ? 'Project details' : 'How can we help?'} <span>*</span>
      <textarea
        id={`${id}-message`}
        name="message"
        required
        minlength="10"
        maxlength="3000"
        rows="3"
        placeholder="Tell us a little about your building and requirements…"
      ></textarea>
    </label>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label>
      Leave this empty
      <input name="_honey" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <div class="consent-field">
    <input id={`${id}-consent`} type="checkbox" name="consent" value="Agreed to enquiry processing" required />
    <label for={`${id}-consent`}>I agree to my details being used to respond to this enquiry, as described in the <a href="/privacy-policy/">privacy policy</a>.</label>
  </div>
  <p class="form-note">
    Your enquiry is sent through FormSubmit to liftsbazar2025@gmail.com.
  </p>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit" data-channel="email">
      <span>Send Enquiry</span>
      <span aria-hidden="true">→</span>
    </button>
    <button class="btn btn-whatsapp" type="submit" data-channel="whatsapp" data-whatsapp-button hidden>
      <WhatsAppIcon size={19} />
      <span>Send via WhatsApp</span>
    </button>
  </div>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="form-note">You can also <a href="tel:+919679112375">call +91 9679112375</a> or <a href="mailto:liftsbazar2025@gmail.com">email our team</a>.</p>
  <noscript>
    <p>
      Your browser will submit securely through FormSubmit and return to our thank-you page. Use Back to return to your details if delivery fails.
    </p>
  </noscript>
</form>
