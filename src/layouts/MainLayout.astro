---
import SiteImage from '../components/SiteImage.astro';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import bodyFont from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import displayFont from '@fontsource/manrope/files/manrope-latin-800-normal.woff2?url';
import { business, offices, primaryPhone, products, services } from '../data/site';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { SITE_URL } from '../data/config';
import { release } from '../data/release';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  preload?: { src: string; srcset?: string };
}
const {
  title = 'Elevator Solutions in Siliguri',
  description = 'LB Elevators, a unit of Lifts Bazar Private Limited. Passenger, goods, home, hospital and panoramic lifts, installation, maintenance and AMC in Siliguri.',
  noindex = false,
  preload,
} = Astro.props;
const path = Astro.url.pathname;
const origin = SITE_URL;
const pageUrl = new URL(path, origin).href;
const canonical = noindex ? undefined : pageUrl;
const tel = (p: string) => `tel:${p.replaceAll(' ', '')}`;
const whatsapp = `https://wa.me/${business.whatsapp}?text=${encodeURIComponent('Hello LB Elevators, I would like to discuss a lift requirement.')}`;
const nav = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about-us/' },
  {
    name: 'Elevators',
    href: '/elevators/',
    children: products
      .map((p) => ({ name: p.name, href: `/elevators/${p.slug}/`, note: p.short }))
      .concat([
        {
          name: 'Elevator Door Types',
          href: '/elevator-door-types/',
          note: 'Eight door options',
        },
      ]),
  },
  {
    name: 'Services',
    href: '/services/',
    children: services.map((s) => ({
      name: s.name,
      href: `/services/${s.slug}/`,
      note: s.description,
    })),
  },
  { name: 'Applications', href: '/applications/' },
  { name: 'Gallery', href: '/gallery/' },
  { name: 'Contact', href: '/contact-us/' },
];
const active = (href: string) =>
  href === '/'
    ? path === '/'
    : path.startsWith(href) ||
      (href === '/elevators/' && path === '/elevator-door-types/');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${origin}/#organization`,
  name: business.name,
  legalName: 'Lifts Bazar Private Limited',
  description,
  telephone: offices.flatMap((o) => o.phones),
  email: business.email,
  logo: new URL('/images/brand/logo-color.webp', origin).href,
  address: offices.map((o) => ({
    '@type': 'PostalAddress',
    ...o.postal,
    addressCountry: 'IN',
  })),
  ...(origin
    ? { url: origin, image: new URL('/images/illustrations/hero.webp', origin).href }
    : {}),
};
const crumbs = [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` }];
if (path.startsWith('/elevators/') && path !== '/elevators/') crumbs.push({ '@type': 'ListItem', position: 2, name: 'Elevators', item: `${origin}/elevators/` });
if (path.startsWith('/services/') && path !== '/services/') crumbs.push({ '@type': 'ListItem', position: 2, name: 'Services', item: `${origin}/services/` });
if (path !== '/') crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: title, item: pageUrl });
const graph = { '@context': 'https://schema.org', '@graph': [schema,
  { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: business.name, publisher: { '@id': `${origin}/#organization` } },
  ...(path === '/about-us/' ? [{ '@type': 'Person', '@id': `${origin}/about-us/#binod-yadav`, name: business.director, jobTitle: 'Managing Director', worksFor: { '@id': `${origin}/#organization` } }] : []),
  ...(path !== '/' && path !== '/404.html' ? [{ '@type': 'BreadcrumbList', itemListElement: crumbs }] : []),
] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="lb-release" content={release} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#041634" />
    <title>{title} | LB Elevators</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | LB Elevators`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LB Elevators" />
    {origin && (
      <>
        <meta property="og:url" content={pageUrl} />
        <meta
          property="og:image"
          content={new URL('/images/brand/og-image.png', origin).href}
        />
      </>
    )}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LB Elevators — a unit of Lifts Bazar Private Limited" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | LB Elevators`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/brand/og-image.png`} />
    <meta name="twitter:image:alt" content="LB Elevators logo on a navy background" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-192x192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon-512x512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.src}
        imagesrcset={preload.srcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="topbar">
        <div class="wrap topbar-inner">
          <div class="top-offices">
            <Icon name="pin" size={14} />
            {offices.map((o) => (
              <a
                class="top-address"
                href={o.map}
                target="_blank"
                rel="noopener noreferrer"
                title={o.address}
              >
                {o.city}
              </a>
            ))}
          </div>
          <div class="top-links">
            {offices.map((o) => (
              <a href={tel(o.phones[0])} aria-label={`Call ${o.name} on ${o.phones[0]}`}>
                <Icon name="phone" size={13} />
                <span class="top-office-label">{o.city}:</span>
                {o.phones[0]}
              </a>
            ))}
            <a class="top-email" href={`mailto:${business.email}`}>
              <Icon name="mail" size={14} />
              {business.email}
            </a>
          </div>
        </div>
      </div>
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="LB Elevators home">
          <SiteImage
            class="brand-light"
            src="/images/brand/logo-light.webp"
            width="220"
            height="79"
            alt=""
          />
          <SiteImage
            class="brand-color"
            src="/images/brand/logo-color.webp"
            width="220"
            height="79"
            alt=""
          />
        </a>
        <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
          <ul class="nav-list">
            {nav.map((n) => (
              <li class:list={['nav-li', n.children && 'has-dropdown']}>
                <div class="nav-item">
                  <a
                    href={n.href}
                    class:list={['nav-link', active(n.href) && 'active']}
                    aria-current={path === n.href ? 'page' : undefined}
                  >
                    {n.name}
                  </a>
                  {n.children && (
                    <button
                      class="dropdown-toggle"
                      aria-expanded="false"
                      aria-label={`Show ${n.name.toLowerCase()} menu`}
                    >
                      <Icon name="chevron" size={14} />
                    </button>
                  )}
                </div>
                {n.children && (
                  <div class="dropdown">
                    <ul>
                      {n.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            aria-current={path === c.href ? 'page' : undefined}
                          >
                            <strong>{c.name}</strong>
                            <small>{c.note}</small>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a class="dropdown-all" href={n.href}>
                      View all {n.name.toLowerCase()} <Icon size={15} />
                    </a>
                  </div>
                )}
              </li>
            ))}
          </ul>
          <div class="nav-mobile-contact">
            <strong class="nav-mobile-company">{business.company}</strong>
            {offices.map((o) => (
              <div class="nav-mobile-office">
                <small>{o.name}</small>
                {o.phones.map((p) => (
                  <a href={tel(p)}>
                    <Icon name="phone" size={16} />
                    {p}
                  </a>
                ))}
              </div>
            ))}
            <a href={`mailto:${business.email}`}>
              <Icon name="mail" size={16} />
              {business.email}
            </a>
          </div>
        </nav>
        <a class="btn btn-primary btn-sm header-quote" href="/request-a-quote/">
          <span>Get a Quote</span>
          <Icon size={16} />
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="primary-nav"
          aria-label="Open navigation"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <aside class="floor-indicator" aria-hidden="true">
      <div class="floor-display">
        <span class="floor-arrow">▲</span>
        <b data-floor-number>G</b>
      </div>
      <span class="floor-label" data-floor-label>Lobby</span>
      <div class="floor-track"><i data-floor-progress></i></div>
    </aside>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-cta">
        <div>
          <p class="eyebrow light">Building a higher tomorrow</p>
          <h2>
            Let’s take your building <em class="serif">higher.</em>
          </h2>
        </div>
        <div class="footer-cta-actions">
          <a class="btn btn-primary" href="/request-a-quote/">
            <span>Request a Quote</span>
            <Icon size={18} />
          </a>
          <a class="btn btn-ghost-light" href={tel(primaryPhone)}>
            <Icon name="phone" size={17} />
            <span>Call {primaryPhone}</span>
          </a>
        </div>
      </div>
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a href="/" aria-label="LB Elevators home">
            <SiteImage
              src="/images/brand/logo-light.webp"
              width="220"
              height="79"
              loading="lazy"
              alt=""
            />
          </a>
          <p>
            Leading the way in innovative vertical mobility — passenger, goods,
            home, hospital and panoramic lifts with installation, maintenance,
            modernization and AMC support from Siliguri and New Delhi.
          </p>
          <div class="brand-rule" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
          </div>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/about-us/">Our Company</a></li>
            <li><a href="/elevators/">Elevator Solutions</a></li>
            <li><a href="/services/">Our Services</a></li>
            <li><a href="/elevator-door-types/">Door Types</a></li>
            <li><a href="/applications/">Applications</a></li>
            <li><a href="/gallery/">Visual Gallery</a></li>
            <li><a href="/contact-us/">Contact Us</a></li>
          </ul>
        </div>
        <div>
          <h2>Elevators</h2>
          <ul>
            {products.map((p) => (
              <li>
                <a href={`/elevators/${p.slug}/`}>{p.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Services</h2>
          <ul>
            {services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-contact-col">
          <h2>Get in touch</h2>
          <p class="footer-company">{business.company}</p>
          {offices.map((o) => (
            <div class="footer-office">
              <h3>{o.name}</h3>
              <div class="footer-contact">
                <Icon name="pin" size={17} />
                <a href={o.map} target="_blank" rel="noopener noreferrer">
                  {o.address}
                </a>
              </div>
              <div class="footer-contact">
                <Icon name="phone" size={17} />
                <div>
                  {o.phones.map((p) => <a href={tel(p)}>{p}</a>)}
                </div>
              </div>
            </div>
          ))}
          <div class="footer-contact">
            <Icon name="mail" size={17} />
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>
          © {new Date().getFullYear()} LB Elevators. A Unit of Lifts Bazar
          Private Limited.
        </p>
        <div>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
        </div>
      </div>
    </footer>
    <div class="float-actions">
      <a
        class="float-call"
        href={tel(primaryPhone)}
        aria-label={`Call LB Elevators on ${primaryPhone}`}
      >
        <Icon name="phone" size={20} />
      </a>
      <a
        class="float-whatsapp"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with LB Elevators on WhatsApp"
      >
        <span class="float-whatsapp-label">Chat with us</span>
        <span class="float-whatsapp-icon">
          <WhatsAppIcon size={30} />
        </span>
      </a>
    </div>
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
