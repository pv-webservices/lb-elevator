---
import MainLayout from '../layouts/MainLayout.astro';
import InnerHero from '../components/InnerHero.astro';
---

<MainLayout
  title="Terms & Conditions — Pending Review"
  description="LB Elevators website terms are pending business review and approval."
  noindex
>
  <InnerHero
    title="Terms & conditions"
    crumb="Terms & Conditions"
    eyebrow="Website information"
    description="Final website terms pending business review and approval."
  />
  <section class="section">
    <div class="wrap legal">
      <p class="note">
        Approved legal terms have not been supplied. This page identifies the
        pending review and must be completed before public launch.
      </p>
      <h2>Product and service information</h2>
      <p>
        This website introduces elevator categories and services.
        Project-specific specifications, suitability, pricing, service
        arrangements and contract terms require discussion with LB Elevators.
      </p>
      <h2>Representative visuals</h2>
      <p>
        Brochure and generated architectural images illustrate product
        categories and design possibilities. They do not establish actual
        installations, client projects or technical specifications.
      </p>
      <h2>Discuss your requirements</h2>
      <p>
        For a written proposal or clarification about any solution,{' '}
        <a class="link-arrow" href="/contact-us/">
          contact our team
        </a>
        .
      </p>
    </div>
  </section>
</MainLayout>
